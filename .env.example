# LLM Provider Configuration
# Options: "ollama", "gemini", "openai", or "openrouter"
LLM_PROVIDER=openai

# Default model to use
# For Ollama:     "gemma3:4b", "qwen3:4b", "mistral:7b", etc.
# For Gemini:     "gemini-2.5-pro", "gemini-2.5-flash", etc.
# For OpenAI:     "gpt-4o", "gpt-4o-mini", "gpt-4.1", "gpt-4.1-mini"
# For OpenRouter: any model id, e.g. "openai/gpt-4o", "anthropic/claude-3.7-sonnet",
#                 "google/gemini-2.5-pro", "deepseek/deepseek-chat"
DEFAULT_MODEL=gpt-4o

# Google Gemini API Key (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter API Key (required if LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
